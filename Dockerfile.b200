# syntax=docker/dockerfile:1.6
#
# Patched vLLM 0.31.0 image for DeepSeek-V4.1-Flash on B200,
# digest-pinned for attestation.
ARG VLLM_BASE_IMAGE=vllm/vllm-openai@sha256:a4a4c0437bf7240089da5f08aa370c4aee17ae5290f7a3b468825ee26c4c3a6b
ARG SIDECAR_IMAGE=ghcr.io/tinfoilsh/inference-sidecar@sha256:65ce23d6560c46a1e8614ede187fcbf9798b267aa33878905b4872404787f47d
FROM ${SIDECAR_IMAGE} AS sidecar

FROM ${VLLM_BASE_IMAGE}

ENV VLLM_DISABLE_UVA=1 \
    VLLM_TINFOIL_CC_OPTIMIZATIONS=1

# Patches are -p1 unified diffs rooted at /; they target
# usr/local/lib/python3.12/dist-packages/... to match the base image.
COPY patches/ /tmp/tinfoil-patches/
RUN set -eux; \
    test "$VLLM_BUILD_COMMIT" = "db9527a46873454610df6dbedf79a36d6bf1a7f6"; \
    python3 -c "from importlib.metadata import version; assert version('vllm') == '0.31.0'"; \
    test -x /usr/bin/patch; \
    cd /; \
    for p in /tmp/tinfoil-patches/*.patch; do \
        echo "Applying $(basename "$p")"; \
        /usr/bin/patch -p1 --batch --forward --no-backup-if-mismatch --fuzz=0 < "$p"; \
    done; \
    find /usr/local/lib/python3.12/dist-packages/vllm -name '__pycache__' -type d -exec rm -rf {} + || true; \
    rm -rf /tmp/tinfoil-patches; \
    python3 -c "import vllm; print('vllm', vllm.__version__, 'with tinfoil patches')"

# Verify the generic artifacts and bake B200 SM100a artifacts for offline use.
COPY scripts/bake-artifacts.py scripts/flashinfer-artifacts.json /tmp/tinfoil-artifacts/
RUN FLASHINFER_CUDA_ARCH_LIST=10.0a python3 /tmp/tinfoil-artifacts/bake-artifacts.py --architecture sm_100a && \
    rm -rf /tmp/tinfoil-artifacts

COPY b200/patches/ /tmp/tinfoil-b200-patches/
RUN set -eu; \
    cd /; \
    for p in /tmp/tinfoil-b200-patches/*.patch; do \
        patch -p1 --batch --forward --no-backup-if-mismatch --fuzz=0 < "$p"; \
    done; \
    rm -rf /tmp/tinfoil-b200-patches

ARG B200_KERNEL_BUNDLE_SHA256=16b879a7ba3856fa7f846bd03215a87aef151da2b258a4382b411927875e2d25
ADD https://github.com/tinfoilsh/confidential-deepseek-v4-1-flash/releases/download/b200-kernels-v3/b200-normal-cc-kernels-r3.tar.gz /tmp/b200-kernels.tar.gz
RUN echo "${B200_KERNEL_BUNDLE_SHA256}  /tmp/b200-kernels.tar.gz" | sha256sum -c - && \
    mkdir -p /opt/tinfoil && \
    tar -xzf /tmp/b200-kernels.tar.gz -C /opt/tinfoil && rm /tmp/b200-kernels.tar.gz
COPY scripts/b200_bundle.py scripts/b200_runtime.py scripts/b200_finalist.py /opt/tinfoil/
COPY b200/build.json /opt/tinfoil/b200-finalist-build.json
COPY b200/runtime-build.json /opt/tinfoil/b200-runtime-build.json
COPY scripts/b200-entrypoint.sh /opt/tinfoil/entrypoint.sh
RUN python3 -c 'import hashlib,json; from pathlib import Path; root=Path("/usr/local/lib/python3.12/dist-packages"); manifest=json.loads(Path("/opt/tinfoil/b200-finalist-bundle/manifest.json").read_text()); sources=manifest["identity"]["software"]["sources"]; actual={str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for package in ("vllm","flashinfer") for p in (root/package).rglob("*.py")}; assert actual == sources, "The qualified inference sources differ"' && \
    python3 -m py_compile /opt/tinfoil/b200_bundle.py /opt/tinfoil/b200_runtime.py /opt/tinfoil/b200_finalist.py && \
    chmod 755 /opt/tinfoil/entrypoint.sh
ENV FLASHINFER_GLOBALTIMER_LIBRARY=/opt/tinfoil/compiled/flashinfer_globaltimer.so
COPY --from=sidecar /inference-sidecar /opt/tinfoil/inference-sidecar
ENTRYPOINT ["python3", "/opt/tinfoil/b200_finalist.py", "vllm", "serve"]
