+class TargetVerification:
+    def __init__(self, runner):
+        self.runner = weakref.ref(runner)
+        self.manager = weakref.ref(runner.cudagraph_manager)
+        self.model, self.buffers = runner.model, runner.input_buffers
+        self.owner, self.sampler = runner.rejection_sampler, runner.sampler
+        self.speculator, self.draft = runner.speculator, runner.speculator.draft_logits
+        self.head = self.model.language_model.lm_head
+        self.quant_method = self.head.quant_method
+        self.processor = self.model.language_model.logits_processor
+        self.processor_values = tuple(getattr(self.processor, name) for name in PROCESSOR_FIELDS)
+        self.weights = head_tensors(self.model)
+        self.weight_keys = tuple(map(tensor_key, self.weights))
+        self.storage = tuple(t.detach() for t in self.weights)
+        self.stream = torch.cuda.current_stream().cuda_stream
+        self.entries, self.plans, self.graphs = {}, {}, {}
+        self.generation = 0
+        self.proof = None
+
+    def begin_step(self):
+        self.generation += 1
+        self.proof = None
+
+    def prepare(self, desc):
+        if not cc_target_preparation.supports(desc):
+            raise ValueError("Unsupported target verification capture")
+        if desc not in self.entries:
+            self.entries[desc] = Entry(self, desc.num_reqs)
+        return self.entries[desc]
+
+    def freeze(self):
+        if not self.graphs or self.graphs.keys() != self.entries.keys() or self.graphs.keys() != self.plans.keys():
+            raise ValueError("Target verification capture inventory differs")
+        LOGGER.info("CC_TARGET_VERIFICATION captured: rank=%s requests=%s",
+                    self.buffers.device.index, sorted(desc.num_reqs for desc in self.graphs))
+
+    def valid_owner(self, runner):
+        if (runner is not self.runner() or runner.cudagraph_manager is not self.manager()
+                or runner.model is not self.model or runner.input_buffers is not self.buffers
+                or runner.rejection_sampler is not self.owner or runner.sampler is not self.sampler
+                or self.owner.sampler is not self.sampler or runner.speculator is not self.speculator
+                or runner.speculator.draft_logits is not self.draft
+                or self.model.language_model.lm_head is not self.head
+                or self.head.quant_method is not self.quant_method
+                or self.model.language_model.logits_processor is not self.processor
+                or tuple(getattr(self.processor, name) for name in PROCESSOR_FIELDS) != self.processor_values):
+            return False
+        current = head_tensors(self.model)
+        return (len(current) == len(self.weights)
+                and all(t is retained and tensor_key(t) == key
+                        for t, retained, key in zip(current, self.weights, self.weight_keys)))
+
+    def eligible(self, runner, batch, entry):
+        from vllm.v1.worker.gpu.kv_connector import NO_OP_KV_CONNECTOR
+
+        if not self.valid_owner(runner):
+            raise ValueError("Reinitialize target verification after replacing model or sampler storage")
+        if (runner.kv_connector is not NO_OP_KV_CONNECTOR
+                or self.stream != torch.cuda.current_stream().cuda_stream
+                or batch.has_prefill or batch.has_structured_output_reqs
+                or not batch.decode_graph_eligible or batch.num_reqs != entry.requests
+                or batch.num_reqs_after_padding != entry.requests
+                or batch.num_tokens != entry.rows or batch.num_tokens_after_padding != entry.rows
+                or batch.num_draft_tokens != entry.requests * SPECULATIVE_DEPTH
+                or not np.all(batch.num_scheduled_tokens == QUERY_LENGTH)
+                or not np.array_equal(batch.cu_num_logits_np, entry.cumulative_cpu)
+                or batch.logits_indices.shape != (entry.rows,)
+                or batch.idx_mapping.shape != (entry.requests,) or batch.idx_mapping.stride() != (1,)
+                or batch.idx_mapping.dtype != torch.int32 or batch.idx_mapping.device != entry.mapping.device
+                or batch.idx_mapping_np.shape != (entry.requests,)
+                or self.sampler.compute_nans or self.sampler.use_fp64_gumbel
+                or self.owner.watermark_key is not None or not self.owner.use_block_verification
+                or self.owner.synthetic_conditional_rates is not None
+                or self.owner.enable_adaptive_verification
+                or self.owner.num_speculative_steps != SPECULATIVE_DEPTH):
+            return False
+        indices = batch.idx_mapping_np
+        if (np.any(indices < 0) or np.any(indices >= entry.slots)
+                or self.sampler.sampling_states.max_num_logprobs(indices) != NO_LOGPROBS
+                or np.any(self.sampler.needs_non_sampling_processing[indices])
+                or np.any(self.sampler.sampling_states.min_p.np[indices] != 0)
+                or np.any(self.sampler.sampling_states.top_k.np[indices] != VOCAB_SIZE)):
+            return False
+        current = bindings(batch.input_ids, batch.positions, batch.seq_lens, self.draft, entry.requests)
+        if (tuple(map(tensor_key, current)) != entry.keys
+                or tensor_key(self.manager().hidden_states[:entry.rows]) != entry.hidden_key):
+            raise ValueError("Reinitialize target verification after replacing captured inputs")
+        return tuple(tensor_key(t)[1:] for t in request_state(self.sampler)) == entry.state_layout
+
+    def select(self, runner, desc, batch, dummy_run, is_profile):
+        if dummy_run or is_profile or desc not in self.graphs or desc not in self.plans:
+            return False
+        return self.eligible(runner, batch, self.entries[desc])
+
+    def replay(self, desc, batch):
+        manager = self.manager()
+        entry = self.entries[desc]
+        entry.stage(batch, self.sampler)
+        original = manager.graphs[desc]
+        manager.graphs[desc] = self.graphs[desc]
+        try:
+            result = manager.run_fullgraph(desc)
+        finally:
+            manager.graphs[desc] = original
+        self.proof = PreparedVerification(self, self.generation, batch, entry)
+        entry.replays = min(entry.replays + 1, REPORT_REPLAYS + 1)
+        if entry.replays == REPORT_REPLAYS:
+            LOGGER.info("CC_TARGET_VERIFICATION replay active: rank=%s requests=%s count=%s",
+                        self.buffers.device.index, entry.requests, entry.replays)
+        return result
+
+    def consume(self, runner, hidden, batch, grammar):
+        proof, self.proof = self.proof, None
+        return proof.consume(runner, hidden, batch, grammar) if proof is not None else None
+
