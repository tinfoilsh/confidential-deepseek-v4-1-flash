+"""Append native head and verification work to qualified target replays."""
+
+from dataclasses import dataclass
+import os
+import weakref
+
+import numpy as np
+import torch
+
+from vllm.logger import init_logger
+from vllm.triton_utils import tl, triton
+from vllm.v1.sample.ops.topk_topp_sampler import apply_top_k_top_p
+from vllm.v1.worker.gpu.sample.gumbel import apply_temperature
+from vllm.v1.worker.gpu import cc_target_preparation
+from vllm.v1.worker.gpu.input_batch import get_num_sampled_and_rejected
+from vllm.v1.worker.gpu.sample.output import SamplerOutput
+from vllm.v1.worker.gpu.sample.states import NO_LOGPROBS
+from vllm.v1.worker.gpu.spec_decode.cc_verification_graphs import (
+    COPY_WARPS, INT32_BYTES, INT64_BYTES, QUERY_LENGTH, SPECULATIVE_DEPTH,
+    VOCAB_SIZE, bindings, request_state as verification_state, stage_request_state, tensor_key,
+)
+from vllm.v1.worker.gpu.spec_decode.rejection_sampler import gather_draft_sampled
+from vllm.v1.worker.gpu.spec_decode.rejection_sampler_utils import rejection_sample
+
+LOGGER = init_logger(__name__)
+TP_SIZE = 4
+SINGLE_PARTITION = 1
+HIDDEN_SIZE = 5120
+REPORT_REPLAYS = 16
+PROCESSOR_FIELDS = ("scale", "vocab_size", "logits_as_input", "org_vocab_size",
+                    "soft_cap", "use_all_gather", "head_dtype")
+
+
+def request_state(sampler):
+    return (*verification_state(sampler), sampler.sampling_states.top_p.gpu)
+
+
+@triton.jit
+def stage_sampling_state(mapping, prefill, temperature, seeds, top_p,
+                         owned_mapping, owned_prefill, owned_temperature, owned_seeds, owned_top_p,
+                         REQUESTS: tl.constexpr, SLOTS: tl.constexpr, BLOCK: tl.constexpr):
+    stage_request_state(mapping, prefill, temperature, seeds, owned_mapping,
+                        owned_prefill, owned_temperature, owned_seeds, REQUESTS, SLOTS, BLOCK)
+    offset = tl.arange(0, BLOCK)
+    value = tl.load(top_p + offset, mask=offset < SLOTS, other=1.0)
+    tl.store(owned_top_p + offset, value, mask=offset < SLOTS)
+
+
+def head_tensors(model):
+    head = model.language_model.lm_head
+    return tuple((*head.parameters(), *head.buffers()))
+
+
+class Entry:
+    def __init__(self, owner, requests):
+        self.requests, self.rows = requests, requests * QUERY_LENGTH
+        self.model = owner.model
+        buffers = owner.buffers
+        self.sources = tuple(t.detach() for t in bindings(
+            buffers.input_ids, buffers.positions, buffers.seq_lens, owner.draft, requests))
+        self.keys = tuple(map(tensor_key, self.sources))
+        self.hidden = owner.manager().hidden_states[:self.rows].detach()
+        self.hidden_key = tensor_key(self.hidden)
+        self.slots = owner.sampler.sampling_states.max_num_reqs
+        state = request_state(owner.sampler)
+        self.state_layout = tuple(tensor_key(t)[1:] for t in state)
+        self.state = tuple(torch.zeros_like(t) for t in state)
+        self.state[-1].fill_(1)
+        device = self.hidden.device
+        self.mapping = torch.arange(requests, dtype=torch.int32, device=device)
+        self.expanded_rows = torch.arange(requests, device=device).repeat_interleave(QUERY_LENGTH)
+        self.local = torch.arange(QUERY_LENGTH, dtype=torch.int32, device=device).repeat(requests)
+        self.cumulative = torch.arange(requests + 1, dtype=torch.int32, device=device) * QUERY_LENGTH
+        self.cumulative_cpu = np.arange(requests + 1, dtype=np.int32) * QUERY_LENGTH
+        self.indices = torch.arange(self.rows, dtype=torch.int64, device=device)
+        self.token_bytes, self.count_bytes = self.rows * INT64_BYTES, requests * INT32_BYTES
+        self.packet = torch.empty(self.token_bytes + self.count_bytes * 2,
+                                  dtype=torch.uint8, device=device)
+        self.destinations = self.unpack(self.packet)
+        self.replays = 0
+        self.samples = 0
+
+    def unpack(self, packet):
+        return (packet[:self.token_bytes].view(torch.int64).view(self.requests, QUERY_LENGTH),
+                packet[self.token_bytes:self.token_bytes + self.count_bytes].view(torch.int32),
+                packet[self.token_bytes + self.count_bytes:].view(torch.int32))
+
+    def capture(self):
+        logits = self.model.compute_logits(self.hidden[self.indices])
+        if logits.shape != (self.rows, VOCAB_SIZE) or logits.dtype != torch.bfloat16:
+            raise ValueError("Target verification requires the qualified BF16 head")
+        inputs, positions, lengths, draft = self.sources
+        prefill, temperature, seeds, top_p = self.state
+        expanded = self.mapping[self.expanded_rows]
+        logits = torch.empty_like(logits, dtype=torch.float32).copy_(logits)
+        apply_temperature(logits, expanded, temperature)
+        logits = apply_top_k_top_p(logits, None, top_p[expanded])
+        sampled, pos = gather_draft_sampled(inputs, positions, self.indices,
+                                          expanded, self.local, prefill)
+        tokens, counts = rejection_sample(logits, draft, sampled, self.cumulative, pos,
+            self.mapping, expanded, self.local, temperature, seeds, SPECULATIVE_DEPTH,
+            use_fp64=False, use_block_verification=True)
+        counts, rejected = get_num_sampled_and_rejected(
+            counts, lengths, self.cumulative, self.mapping, prefill)
+        for destination, source in zip(self.destinations, (tokens, counts, rejected)):
+            destination.copy_(source)
+
+    def stage(self, batch, sampler):
+        stage_sampling_state[(1,)](batch.idx_mapping, *request_state(sampler),
+            self.mapping, *self.state, REQUESTS=self.requests, SLOTS=self.slots,
+            BLOCK=1 << (self.slots - 1).bit_length(), num_warps=COPY_WARPS)
+
+    def snapshot(self):
+        # Readback and drafting retain their own packet after later target replays.
+        tokens, counts, rejected = self.unpack(self.packet.clone())
+        self.samples = min(self.samples + 1, REPORT_REPLAYS + 1)
+        if self.samples == REPORT_REPLAYS:
+            LOGGER.info("CC_TARGET_VERIFICATION sample active: rank=%s requests=%s count=%s",
+                        self.hidden.device.index, self.requests, self.samples)
+        return SamplerOutput(sampled_token_ids=tokens, logprobs_tensors=None,
+                             num_nans=None, num_sampled=counts, num_rejected=rejected)
+
+
+@dataclass
+class PreparedVerification:
+    owner: object
+    generation: int
+    batch: object
+    entry: Entry
+    consumed: bool = False
+
+    def consume(self, runner, hidden, batch, grammar):
+        if self.consumed:
+            return None
+        self.consumed = True
+        owner = self.owner
+        if (self.generation != owner.generation or batch is not self.batch
+                or grammar is not None or tensor_key(hidden) != self.entry.hidden_key
+                or not owner.eligible(runner, batch, self.entry)):
+            return None
+        return self.entry.snapshot()
+
