+"""Limit prefill capture inventory while retaining native decode descriptors."""
+
+import os
+
+from vllm.config.compilation import CUDAGraphMode
+
+COMPACT_SIZES = frozenset((512, 1024, 2048, 4096, 8192))
+COMPACT = os.environ.get("TINFOIL_PREFILL_CAPTURE_SET") == "compact"
+
+
+def include(mode, num_tokens):
+    return not COMPACT or mode != CUDAGraphMode.PIECEWISE or num_tokens in COMPACT_SIZES
