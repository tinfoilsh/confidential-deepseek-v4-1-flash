--- /dev/null
+++ b/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/cc_target_preparation.py
@@ -0,0 +1,212 @@
+"""Capture native target preparation with its consumer for uniform decode."""
+
+from dataclasses import fields, is_dataclass
+import os
+import weakref
+
+import torch
+
+from vllm.config.compilation import CUDAGraphMode
+from vllm.logger import init_logger
+from vllm.v1.worker.gpu.input_batch import InputBatch
+from vllm.v1.worker.gpu.model_states.default import DefaultModelState
+
+LOGGER = init_logger(__name__)
+MAX_REQUESTS = 8
+QUERY_LENGTH = 6
+TP_SIZE = 4
+SINGLE_PARTITION = 1
+REPORT_REPLAYS = 16
+CAPACITY = 16384
+MAX_MODEL_LENGTH = 1048576
+WINDOW = 128
+SWA_BLOCK_SIZE = 32
+GROUP_IDS = (0, 1, 2, 3, 4, 4, 4, 4, 5)
+
+
+def tensor_key(value):
+    return value.data_ptr(), tuple(value.shape), value.stride(), value.dtype, value.device
+
+
+def tensors(value):
+    if isinstance(value, torch.Tensor):
+        return (value,) if value.is_cuda else ()
+    if is_dataclass(value):
+        values = (getattr(value, field.name) for field in fields(value))
+    elif isinstance(value, dict):
+        values = value.values()
+    elif isinstance(value, (tuple, list)):
+        values = value
+    else:
+        return ()
+    return tuple(tensor for item in values for tensor in tensors(item))
+
+
+def entries(groups):
+    return tuple((gid, group, group.get_metadata_builder())
+                 for gid, values in enumerate(groups) for group in values)
+
+
+def layout(groups):
+    return tuple((gid, id(group), tuple(group.layer_names), id(group.kv_cache_spec),
+                  tuple(id(builder) for builder in group.metadata_builders))
+                 for gid, values in enumerate(groups) for group in values)
+
+
+def supports(desc):
+    return (desc.cg_mode == CUDAGraphMode.FULL and desc.num_ubatches == SINGLE_PARTITION
+            and not desc.num_active_loras and desc.uniform_token_count == QUERY_LENGTH
+            and desc.num_reqs is not None and 0 < desc.num_reqs <= MAX_REQUESTS
+            and desc.num_tokens == desc.num_reqs * QUERY_LENGTH)
+
+
+class Bindings:
+    def __init__(self, owners):
+        self.attributes = tuple((owner, name, tuple(tensor_key(t) for t in tensors(value)))
+                                for owner in owners for name, value in vars(owner).items()
+                                if tensors(value))
+        # Detached views keep captured allocations alive if an owner replaces Tensor.data.
+        self.storage = tuple(t.detach() for owner, name, _ in self.attributes
+                             for t in tensors(getattr(owner, name)))
+
+    def matches(self):
+        return all(tuple(tensor_key(t) for t in tensors(getattr(owner, name, None))) == keys
+                   for owner, name, keys in self.attributes)
+
+
+class Preparation:
+    def __init__(self, state, batch, block_tables, slot_mappings, groups, kv_config):
+        self.state, self.batch = state, batch
+        self.block_tables, self.slot_mappings = block_tables, slot_mappings
+        self.groups, self.kv_config = groups, kv_config
+        from vllm.v1.worker.gpu.attn_utils import build_slot_mappings_by_layer
+
+        self.slot_mappings_by_layer = build_slot_mappings_by_layer(slot_mappings, kv_config)
+        self.metadata = None
+        self.storage = ()
+
+    def run(self):
+        # Pure decode has no prefix replay boundary; native builders own the zero marker.
+        self.metadata = DefaultModelState.prepare_attn(
+            self.state, self.batch, CUDAGraphMode.FULL, self.block_tables,
+            self.slot_mappings, self.groups, self.kv_config, for_capture=True)
+        self.storage = tuple(t.detach() for t in tensors(self.metadata))
+        return self.metadata
+
+
+class TargetPreparation:
+    def __init__(self, manager, model, state, buffers, tables, groups, kv_config):
+        self.manager = weakref.ref(manager)
+        self.model, self.state, self.buffers, self.tables = model, state, buffers, tables
+        self.groups, self.kv_config = groups, kv_config
+        self.layout = layout(groups)
+        self.graphs, self.plans, self.replays = {}, {}, {}
+        self.stream = torch.cuda.current_stream().cuda_stream
+        self.bindings = None
+
+    def prepare(self, desc):
+        batch = InputBatch.make_dummy(desc.num_reqs, desc.num_tokens, self.buffers,
+                                      max_query_len=QUERY_LENGTH)
+        return Preparation(self.state, batch, self.tables.get_dummy_block_tables(desc.num_reqs),
+                           self.tables.get_dummy_slot_mappings(desc.num_tokens),
+                           self.groups, self.kv_config)
+
+    def freeze(self):
+        self.bindings = Bindings((self.buffers, self.tables, self.state,
+                                  *(builder for _, _, builder in entries(self.groups))))
+        LOGGER.info('CC_TARGET_PREPARATION captured: rank=%s requests=%s builders=%s',
+                    self.buffers.device.index, sorted(desc.num_reqs for desc in self.graphs),
+                    len(entries(self.groups)))
+
+    def select(self, runner, desc, batch, block_tables, slot_mappings, dummy_run):
+        from vllm.v1.worker.gpu.kv_connector import NO_OP_KV_CONNECTOR
+
+        if (runner.cudagraph_manager is not self.manager() or runner.model is not self.model
+                or runner.model_state is not self.state or runner.input_buffers is not self.buffers
+                or runner.block_tables is not self.tables or runner.attn_groups is not self.groups
+                or runner.kv_cache_config is not self.kv_config or layout(runner.attn_groups) != self.layout
+                or self.bindings is None or not self.bindings.matches()):
+            raise ValueError('Reinitialize target graphs after changing model, cache, or captured buffers')
+        if (dummy_run or desc not in self.graphs or desc not in self.plans
+                or runner.kv_connector is not NO_OP_KV_CONNECTOR
+                or self.stream != torch.cuda.current_stream().cuda_stream
+                or batch.has_prefill or not batch.decode_graph_eligible
+                or batch.num_reqs != desc.num_reqs
+                or batch.num_reqs_after_padding != desc.num_reqs
+                or batch.num_tokens != desc.num_tokens or batch.num_tokens_after_padding != desc.num_tokens
+                or batch.num_draft_tokens != batch.num_reqs * (QUERY_LENGTH - 1)
+                or not (batch.num_scheduled_tokens == QUERY_LENGTH).all()):
+            return False
+        plan = self.plans[desc]
+        actual = (batch.query_start_loc, batch.seq_lens, batch.positions, slot_mappings, *block_tables)
+        expected = (plan.batch.query_start_loc, plan.batch.seq_lens, plan.batch.positions,
+                    plan.slot_mappings, *plan.block_tables)
+        if tuple(map(tensor_key, actual)) != tuple(map(tensor_key, expected)):
+            raise ValueError('Target preparation input storage changed; recapture before replay')
+        return True
+
+    def replay(self, manager, desc):
+        original = manager.graphs[desc]
+        manager.graphs[desc] = self.graphs[desc]
+        try:
+            result = manager.run_fullgraph(desc)
+        finally:
+            manager.graphs[desc] = original
+        count = min(self.replays.get(desc, 0) + 1, REPORT_REPLAYS + 1)
+        self.replays[desc] = count
+        if count == REPORT_REPLAYS:
+            LOGGER.info('CC_TARGET_PREPARATION replay active: rank=%s requests=%s rows=%s count=%s',
+                        self.buffers.device.index, desc.num_reqs, desc.num_tokens, count)
+        return result
+
+
+def qualified_graph_mode(mode):
+    if mode == CUDAGraphMode.FULL_DECODE_ONLY:
+        return os.environ.get('TINFOIL_PREFILL_GRAPHS', '0') == '0'
+    return (mode == CUDAGraphMode.FULL_AND_PIECEWISE
+            and os.environ.get('TINFOIL_PREFILL_GRAPHS') == '1'
+            and os.environ.get('TINFOIL_PREFILL_CAPTURE_SET') == 'compact'
+            and os.environ.get('VLLM_USE_BREAKABLE_CUDAGRAPH') == '1')
+
+
+def create(manager, model, state, buffers, tables, groups, kv_config, pcp_manager, has_lora):
+    if os.environ.get('TINFOIL_TARGET_PREPARATION', '0') != '1':
+        return None
+    from vllm.models.deepseek_v41.compressor import CompressorMetadataBuilder
+    from vllm.models.deepseek_v41.nvidia.flashmla import DeepseekSparseSWAFlashMLAMetadataBuilder
+    from vllm.models.deepseek_v41.nvidia.model_state import DeepseekV41ModelState
+    from vllm.models.deepseek_v41.sparse_mla import DeepseekV4FlashMLAMetadataBuilder
+    from vllm.v1.attention.backends.mla.indexer import DeepseekV32IndexerMetadataBuilder
+
+    config = manager.vllm_config
+    parallel, spec = config.parallel_config, config.speculative_config
+    if not (type(state) is DeepseekV41ModelState
+            and qualified_graph_mode(config.compilation_config.cudagraph_mode)
+            and not has_lora and not config.lora_config and config.kv_transfer_config is None
+            and parallel.tensor_parallel_size == TP_SIZE
+            and parallel.pipeline_parallel_size == parallel.data_parallel_size == SINGLE_PARTITION
+            and parallel.decode_context_parallel_size == parallel.prefill_context_parallel_size == SINGLE_PARTITION
+            and not parallel.enable_expert_parallel and not parallel.enable_dbo
+            and not parallel.use_ubatching and pcp_manager is None
+            and spec.method == 'dspark' and spec.num_speculative_tokens == QUERY_LENGTH - 1
+            and spec.num_speculative_tokens_per_batch_size is None
+            and not spec.enable_adaptive_verification
+            and config.scheduler_config.max_num_batched_tokens == CAPACITY
+            and config.model_config.max_model_len == MAX_MODEL_LENGTH
+            and not config.model_config.is_mm_prefix_lm
+            and torch.cuda.get_device_name(manager.device) == 'NVIDIA B200'):
+        raise ValueError('Target preparation requires the qualified B200 static DSpark TP4 configuration')
+    current = entries(groups)
+    classes = (DeepseekSparseSWAFlashMLAMetadataBuilder,) * 4 + (
+        DeepseekV4FlashMLAMetadataBuilder, DeepseekV32IndexerMetadataBuilder,
+        DeepseekV4FlashMLAMetadataBuilder, DeepseekV32IndexerMetadataBuilder,
+        CompressorMetadataBuilder)
+    if (tuple(gid for gid, _, _ in current) != GROUP_IDS
+            or tuple(type(builder) for _, _, builder in current) != classes
+            or any(len(group.metadata_builders) != SINGLE_PARTITION for _, group, _ in current)
+            or any(builder.window_size != WINDOW or builder.block_size != SWA_BLOCK_SIZE
+                   or builder.max_image_tokens != 0 for _, _, builder in current[:4])
+            or any(not builder.supports_varlen or builder.use_flattening
+                   for _, _, builder in current if type(builder) is DeepseekV32IndexerMetadataBuilder)):
+        raise ValueError('Target preparation requires the measured native nine-builder layout')
+    return TargetPreparation(manager, model, state, buffers, tables, groups, kv_config)
