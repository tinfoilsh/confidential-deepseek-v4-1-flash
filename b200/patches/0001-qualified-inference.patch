+"""Require the exact recorded choices before native warmup can replay them."""
+
+import hashlib
+import json
+
+
+def require_replay_cache(path, expected_key, expected_sha256):
+    if not expected_key or not expected_sha256 or path.parent.name != expected_key:
+        raise RuntimeError("The native tuning-cache key differs from the declared experiment")
+    if not path.is_file():
+        raise RuntimeError("The recorded tuning cache is missing from the native lookup path")
+    payload = json.loads(path.read_text())
+    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    if hashlib.sha256(canonical).hexdigest() != expected_sha256:
+        raise RuntimeError("The native tuning cache differs from the recorded shape choices")
+    entries = sum(not key.startswith("_") for key in payload)
+    if not entries:
+        raise RuntimeError("The native replay cache has no recorded shape choices")
+    return entries
