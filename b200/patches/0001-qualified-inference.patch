+"""Replay uniform DSpark verification with staged inputs and owned result packets."""
+
+import os
+
+import numpy as np
+import torch
+
+from vllm.config.compilation import CUDAGraphMode
+from vllm.logger import init_logger
+from vllm.triton_utils import tl, triton
+from vllm.v1.worker.gpu.input_batch import get_num_sampled_and_rejected
+from vllm.v1.worker.gpu.sample.output import SamplerOutput
+from vllm.v1.worker.gpu.sample.states import NO_LOGPROBS
+from vllm.v1.worker.gpu.spec_decode.rejection_sampler_utils import rejection_sample
+
+ENABLED = os.environ.get("TINFOIL_VERIFICATION_GRAPHS", "0") == "1"
+LOGGER = init_logger(__name__)
+MAX_REQUESTS = 8
+SPECULATIVE_DEPTH = 5
+QUERY_LENGTH = SPECULATIVE_DEPTH + 1
+VOCAB_SIZE = 129280
+TENSOR_PARALLEL_SIZE = 4
+SINGLE_PARTITION = 1
+INT64_BYTES = 8
+INT32_BYTES = 4
+WARMUPS = 3
+REPORT_REPLAYS = 16
+COPY_WARPS = 4
+
+
+@triton.jit
+def stage_request_state(mapping, prefill, temperature, seeds, owned_mapping,
+                        owned_prefill, owned_temperature, owned_seeds,
+                        REQUESTS: tl.constexpr, SLOTS: tl.constexpr, BLOCK: tl.constexpr):
+    offset = tl.arange(0, BLOCK)
+    value = tl.load(prefill + offset, mask=offset < SLOTS, other=0)
+    tl.store(owned_prefill + offset, value, mask=offset < SLOTS)
+    value = tl.load(temperature + offset, mask=offset < SLOTS, other=0)
+    tl.store(owned_temperature + offset, value, mask=offset < SLOTS)
+    value = tl.load(seeds + offset, mask=offset < SLOTS, other=0)
+    tl.store(owned_seeds + offset, value, mask=offset < SLOTS)
+    value = tl.load(mapping + offset, mask=offset < REQUESTS, other=0)
+    tl.store(owned_mapping + offset, value, mask=offset < REQUESTS)
+
+
+def tensor_key(tensor):
+    return (tensor.data_ptr(), tuple(tensor.shape), tensor.stride(), tensor.dtype, tensor.device)
+
+
+def bindings(input_ids, positions, seq_lens, draft_logits, requests):
+    rows = requests * QUERY_LENGTH
+    return input_ids[:rows], positions[:rows], seq_lens[:requests], draft_logits
+
+
+def request_state(sampler):
+    return (sampler.req_states.prefill_len.gpu, sampler.sampling_states.temperature.gpu,
+            sampler.sampling_states.seeds.gpu)
+
+
+class Entry:
+    def __init__(self, sources, state, requests, use_fp64, pool, stream):
+        self.requests = requests
+        self.rows = requests * QUERY_LENGTH
+        self.keys = tuple(tensor_key(tensor) for tensor in sources)
+        self.sources = tuple(tensor.detach() for tensor in sources)
+        self.use_fp64 = use_fp64
+        self.replays = 0
+        device = sources[0].device
+        self.logits = torch.zeros((self.rows, VOCAB_SIZE), dtype=torch.bfloat16, device=device)
+        self.mapping = torch.arange(requests, dtype=torch.int32, device=device)
+        self.state = tuple(torch.zeros_like(tensor) for tensor in state)
+        self.state_layout = tuple(tensor_key(tensor)[1:] for tensor in state)
+        self.slots = state[0].numel()
+        self.expanded_rows = torch.arange(requests, device=device).repeat_interleave(QUERY_LENGTH)
+        self.local = torch.arange(QUERY_LENGTH, dtype=torch.int32, device=device).repeat(requests)
+        self.cumulative = torch.arange(requests + 1, dtype=torch.int32, device=device) * QUERY_LENGTH
+        self.cumulative_cpu = np.arange(requests + 1, dtype=np.int32) * QUERY_LENGTH
+        self.logits_indices = torch.arange(self.rows, dtype=torch.int64, device=device)
+        self.token_bytes = self.rows * INT64_BYTES
+        self.count_bytes = requests * INT32_BYTES
+        self.packed = torch.empty(self.token_bytes + self.count_bytes * 2, dtype=torch.uint8, device=device)
+        self.destinations = self.unpack(self.packed)
+        self.graph = torch.cuda.CUDAGraph()
+        current = torch.cuda.current_stream()
+        stream.wait_stream(current)
+        with torch.cuda.stream(stream):
+            self.stage(self.mapping, state)
+            for _ in range(WARMUPS):
+                self.run()
+        current.wait_stream(stream)
+        with torch.cuda.graph(self.graph, pool=pool, stream=stream):
+            self.run()
+        current.wait_stream(stream)
+
+    def unpack(self, packet):
+        return (packet[:self.token_bytes].view(torch.int64).view(self.requests, QUERY_LENGTH),
+                packet[self.token_bytes:self.token_bytes + self.count_bytes].view(torch.int32),
+                packet[self.token_bytes + self.count_bytes:].view(torch.int32))
+
+    def run(self):
+        from vllm.v1.worker.gpu.spec_decode.rejection_sampler import gather_draft_sampled
+
+        inputs, positions, seq_lens, draft_logits = self.sources
+        prefill, temperature, seeds = self.state
+        expanded = self.mapping[self.expanded_rows]
+        sampled, pos = gather_draft_sampled(inputs, positions, self.logits_indices,
+                                          expanded, self.local, prefill)
+        tokens, counts = rejection_sample(
+            self.logits, draft_logits, sampled, self.cumulative, pos, self.mapping,
+            expanded, self.local, temperature, seeds, SPECULATIVE_DEPTH,
+            use_fp64=self.use_fp64, use_block_verification=True)
+        counts, rejected = get_num_sampled_and_rejected(
+            counts, seq_lens, self.cumulative, self.mapping, prefill)
+        for destination, source in zip(self.destinations, (tokens, counts, rejected)):
+            destination.copy_(source)
+
+    def stage(self, mapping, state):
+        stage_request_state[(1,)](mapping, *state, self.mapping, *self.state,
+                                  REQUESTS=self.requests, SLOTS=self.slots,
+                                  BLOCK=triton.next_power_of_2(self.slots), num_warps=COPY_WARPS)
+
+    def replay(self, logits, mapping, state):
+        self.logits.copy_(logits)
+        self.stage(mapping, state)
+        self.graph.replay()
+        # Each caller owns its packet through asynchronous readback and retirement.
+        sampled, counts, rejected = self.unpack(self.packed.clone())
+        self.replays += 1
+        if self.replays == REPORT_REPLAYS:
+            LOGGER.info("CC_VERIFICATION_GRAPH replay active: rank=%s requests=%s count=%s",
+                        self.logits.device.index, self.requests, self.replays)
+        return SamplerOutput(sampled_token_ids=sampled, logprobs_tensors=None, num_nans=None,
+                             num_sampled=counts, num_rejected=rejected)
+
+
+class VerificationGraphs:
+    def __init__(self, owner, input_buffers, draft_logits):
+        self.owner = owner
+        self.sampler = owner.sampler
+        self.use_fp64 = self.sampler.use_fp64_gumbel
+        self.stream = torch.cuda.current_stream().cuda_stream
+        self.entries = {}
+        pool = torch.cuda.graph_pool_handle()
+        stream = torch.cuda.Stream()
+        state = request_state(self.sampler)
+        slots = self.sampler.sampling_states.max_num_reqs
+        if any(tensor.shape != (slots,) or tensor.stride() != (1,)
+               or tensor.device != draft_logits.device or tensor.dtype != dtype
+               for tensor, dtype in zip(state, (torch.int32, torch.float32, torch.int64))):
+            raise ValueError("Use native contiguous request state on the worker device")
+        for requests in range(1, MAX_REQUESTS + 1):
+            sources = bindings(input_buffers.input_ids, input_buffers.positions,
+                               input_buffers.seq_lens, draft_logits, requests)
+            self.entries[requests] = Entry(sources, state, requests, self.use_fp64, pool, stream)
+
+    def sample(self, owner, logits, batch, draft_logits):
+        sampler = owner.sampler
+        requests = batch.num_reqs
+        entry = self.entries.get(requests)
+        if (owner is not self.owner or sampler is not self.sampler or entry is None
+                or sampler.compute_nans or sampler.use_fp64_gumbel != self.use_fp64
+                or owner.watermark_key is not None or not owner.use_block_verification
+                or owner.synthetic_conditional_rates is not None or owner.enable_adaptive_verification
+                or owner.num_speculative_steps != SPECULATIVE_DEPTH
+                or self.stream != torch.cuda.current_stream().cuda_stream
+                or batch.has_prefill or batch.num_draft_tokens != requests * SPECULATIVE_DEPTH
+                or batch.num_tokens != entry.rows or batch.logits_indices.numel() != entry.rows
+                or logits.shape != (entry.rows, VOCAB_SIZE) or logits.dtype != entry.logits.dtype
+                or logits.device != entry.logits.device or logits.stride(-1) != 1
+                or batch.idx_mapping.shape != (requests,) or batch.idx_mapping.dtype != torch.int32
+                or batch.idx_mapping.stride() != (1,)
+                or batch.idx_mapping.device != entry.mapping.device
+                or batch.idx_mapping_np.shape != (requests,)
+                or not np.all(batch.num_scheduled_tokens == QUERY_LENGTH)
+                or not np.array_equal(batch.cu_num_logits_np, entry.cumulative_cpu)
+                or draft_logits is None):
+            return None
+        indices = batch.idx_mapping_np
+        if (np.any(indices < 0) or np.any(indices >= sampler.sampling_states.max_num_reqs)
+                or sampler.sampling_states.max_num_logprobs(indices) != NO_LOGPROBS
+                or np.any(sampler.needs_logits_processing[indices])):
+            return None
+        sources = bindings(batch.input_ids, batch.positions, batch.seq_lens,
+                           draft_logits, requests)
+        if any(tensor_key(tensor) != key for tensor, key in zip(sources, entry.keys)):
+            return None
+        state = request_state(sampler)
+        if any(tensor_key(tensor)[1:] != layout for tensor, layout in zip(state, entry.state_layout)):
+            return None
+        return entry.replay(logits, batch.idx_mapping, state)
+
+
+def create(runner):
+    from vllm.v1.worker.gpu.kv_connector import NO_OP_KV_CONNECTOR
+    from vllm.v1.worker.gpu.sample.sampler import Sampler
+    from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
+    from vllm.v1.worker.gpu.spec_decode.rejection_sampler import RejectionSampler
+
+    owner = runner.rejection_sampler
+    parallel, spec = runner.parallel_config, runner.speculative_config
+    absent = ("pcp_manager", "ubatch_runner", "batch_sharder", "pooling_runner",
+              "adaptive_verification", "pp_handler", "aux_output_connector")
+    if not (type(owner) is RejectionSampler and type(owner.sampler) is Sampler
+            and type(runner.speculator) is DSparkSpeculator
+            and all(getattr(runner, name) is None for name in absent)
+            and runner.kv_connector is NO_OP_KV_CONNECTOR and not runner.lora_config
+            and runner.cudagraph_manager.cudagraph_mode == CUDAGraphMode.FULL_DECODE_ONLY
+            and parallel.tensor_parallel_size == TENSOR_PARALLEL_SIZE
+            and parallel.pipeline_parallel_size == parallel.data_parallel_size == SINGLE_PARTITION
+            and parallel.decode_context_parallel_size == parallel.prefill_context_parallel_size == SINGLE_PARTITION
+            and not parallel.enable_expert_parallel and not parallel.enable_dbo and not parallel.use_ubatching
+            and spec.method == "dspark" and spec.num_speculative_tokens == SPECULATIVE_DEPTH
+            and spec.num_speculative_tokens_per_batch_size is None and not spec.enable_adaptive_verification
+            and owner.use_block_verification and owner.watermark_key is None
+            and owner.synthetic_conditional_rates is None and not owner.sampler.compute_nans
+            and runner.model_config.head_dtype == torch.bfloat16
+            and owner.sampler.sampling_states.vocab_size == VOCAB_SIZE):
+        raise ValueError("Use native static-five DSpark TP4 verification without offload")
+    return VerificationGraphs(owner, runner.input_buffers, runner.speculator.draft_logits)
