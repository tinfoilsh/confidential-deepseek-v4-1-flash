         conversation, engine_inputs = result

+        if (limit := request.max_input_tokens) is not None:
+            # Check the final decoder-only prompt. Multimodal prompt IDs
+            # already include image placeholders, as does usage.prompt_tokens.
+            token_ids = None
+            if len(engine_inputs) == 1:
+                engine_input = engine_inputs[0]
+                kind = engine_input.get("type")
+                if (
+                    "encoder_prompt_token_ids" not in engine_input
+                    and "encoder_prompt" not in engine_input
+                ):
+                    if kind == "token":
+                        token_ids = engine_input.get("prompt_token_ids")
+                    elif kind == "multimodal":
+                        placeholders = engine_input.get("mm_placeholders")
+                        hashes = engine_input.get("mm_hashes")
+                        if (
