+            if not isinstance(token_ids, list):
+                return self.create_error_response(
+                    "max_input_tokens requires one tokenized decoder-only "
+                    "prompt with text or images only.",
+                    param="max_input_tokens",
+                )
+            if len(token_ids) > limit:
+                return self.create_error_response(
+                    "The rendered prompt exceeds max_input_tokens.",
